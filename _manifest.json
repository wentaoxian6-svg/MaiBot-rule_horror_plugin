{
  "manifest_version": 2,
  "id": "wentaoxian6-svg.rule-horror-plugin",
  "version": "2.3.0",
  "name": "规则怪谈插件",
  "description": "生成规则怪谈并进行互动游戏，支持 LLM 生成、提示、推理和多种结局判定。",
  "author": {
    "name": "岚影鸿夜",
    "url": "https://github.com/wentaoxian6-svg"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/wentaoxian6-svg/MaiBot-rule_horror_plugin",
    "homepage": "https://github.com/wentaoxian6-svg/MaiBot-rule_horror_plugin",
    "documentation": "https://docs.mai-mai.org/develop/plugin-dev/",
    "issues": "https://github.com/wentaoxian6-svg/MaiBot-rule_horror_plugin/issues"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.4.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "send.text",
    "send.image",
    "chat.open_session",
    "message.get_recent",
    "config.get"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
